# LibSQL / Turso database (required)
DATABASE_URL=libsql://your-database-url.turso.io
DATABASE_AUTH_TOKEN=your-database-auth-token

# OpenRouter (required for the AI therapist chat endpoint)
# Get keys at https://openrouter.ai/keys — one per account for rotation & failover
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_API_KEY_2=sk-or-your-second-account-api-key
OPENROUTER_API_KEY_3=sk-or-your-third-account-api-key

# OpenRouter models — one per agent chain step (required)
# Examples: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_2=openai/gpt-4o-mini
OPENROUTER_MODEL_3=openai/gpt-4o-mini

# OpenRouter failover tuning (all optional — defaults shown)
# OPENROUTER_RETRY_BASE_MS=400        # exponential backoff base
# OPENROUTER_RETRY_MAX_MS=4000        # max backoff per retry
# OPENROUTER_MAX_RETRY_AFTER_MS=8000  # cap for honouring Retry-After headers
# OPENROUTER_MAX_RETRIES_PER_COMBO=2  # retries per (model, key) pair
# OPENROUTER_MAX_TOTAL_ATTEMPTS=12    # hard cap across all models/keys

# OpenRouter provider routing (optional, forwarded to OpenRouter's provider object)
# OPENROUTER_PROVIDER_ORDER=anthropic,google-vertex   # comma-separated provider slugs
# OPENROUTER_PROVIDER_SORT=price                      # price|throughput|latency
# OPENROUTER_ALLOW_FALLBACKS=true                     # true|false

# Supabase (public client keys for chat history)
# Find your project URL and anon key in Supabase Dashboard > Settings > API
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key